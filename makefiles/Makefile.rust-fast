CC = cargo
TARGET = main
BUILD_DIR = build/rust-fast
RUST_DIR = rust

.PHONY: all clean

all: $(BUILD_DIR)/$(TARGET)

$(BUILD_DIR)/$(TARGET): $(RUST_DIR)/src/main.rs $(RUST_DIR)/src/lib.rs $(RUST_DIR)/Cargo.toml
	@echo "Building Rust (fast profile)..."
	@mkdir -p $(BUILD_DIR)
	cd $(RUST_DIR) && source ~/.cargo/env && cargo build --profile fast
	@cp $(RUST_DIR)/target/fast/$(TARGET) $(BUILD_DIR)/$(TARGET)
	@echo "✓ Rust fast build complete: $(BUILD_DIR)/$(TARGET)"

clean:
	@echo "Cleaning Rust fast build..."
	@rm -rf $(BUILD_DIR)
	@cd $(RUST_DIR) && cargo clean
	@echo "✓ Rust fast clean complete"