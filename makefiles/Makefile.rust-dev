CC = cargo
TARGET = main
BUILD_DIR = build/rust-dev
RUST_DIR = rust

.PHONY: all clean

all: $(BUILD_DIR)/$(TARGET)

$(BUILD_DIR)/$(TARGET): $(RUST_DIR)/src/main.rs $(RUST_DIR)/src/lib.rs $(RUST_DIR)/Cargo.toml
	@echo "Building Rust (dev profile)..."
	@mkdir -p $(BUILD_DIR)
	cd $(RUST_DIR) && source ~/.cargo/env && cargo build --profile dev
	@cp $(RUST_DIR)/target/debug/$(TARGET) $(BUILD_DIR)/$(TARGET)
	@echo "✓ Rust dev build complete: $(BUILD_DIR)/$(TARGET)"

clean:
	@echo "Cleaning Rust dev build..."
	@rm -rf $(BUILD_DIR)
	@cd $(RUST_DIR) && cargo clean
	@echo "✓ Rust dev clean complete"